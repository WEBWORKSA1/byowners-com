---
layout: null
permalink: /manifest.webmanifest
sitemap: false
---
{
  "name": "ByOwners.com",
  "short_name": "ByOwners",
  "description": "Buy, sell & rent directly from owners.",
  "start_url": "{{ '/' | relative_url }}?source=pwa",
  "scope": "{{ '/' | relative_url }}",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#0f766e",
  "icons": [
    { "src": "{{ '/assets/img/icon-192.png' | relative_url }}", "sizes": "192x192", "type": "image/png" },
    { "src": "{{ '/assets/img/logo-512.png' | relative_url }}", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ]
}
